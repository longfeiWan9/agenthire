    "test:watch": "vitest",
    "check:rpc": "tsx src/scripts/check-rpc.ts",
    "read:agents": "tsx src/scripts/read-agents.ts",
    "read:metadata": "tsx src/scripts/read-metadata.ts",
    "build:catalog": "tsx src/scripts/build-catalog.ts",
    "plan:inspections": "tsx src/scripts/plan-inspections.ts",
    "plan:service-inspections": "tsx src/scripts/plan-service-inspections.ts",
    "inspect:discovery": "tsx src/scripts/inspect-discovery.ts",
    "inspect:x402-discovery": "tsx src/scripts/inspect-x402-discovery.ts",
    "analyze:resources": "tsx src/scripts/analyze-resources.ts",
    "recover:agent402-catalog": "tsx src/scripts/recover-agent402-catalog.ts",
