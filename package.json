    "build:marketplace": "tsx src/scripts/build-marketplace-catalog.ts"
  },
  "dependencies": {
    "viem": "2.58.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
