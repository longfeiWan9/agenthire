{
  "name": "agenthire",
  "version": "0.1.0",
  "private": true,
  "description": "AgentHire — Discover. Trust. Hire. Pay. Verify. Open-source AI agent marketplace.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx src/scripts/hello.ts",
    "typecheck": "tsc --noEmit",
